<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>astra_gazebo</name>
  <version>1.0.0</version>
  <description>
    Gazebo Harmonic simulation of the Astra diff-drive robot for testing the
    RTAB-Map visual odometry pipeline WITHOUT a real robot or a real camera.
    Provides a feature-rich world, ros_gz bridge config, and a full simulation
    launch producing /odom (visual), /wheel/odometry and /ground_truth/odometry.
  </description>
  <maintainer email="you@example.com">Kos220v</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>astra_description</exec_depend>
  <exec_depend>astra_odometry</exec_depend>

  <!-- Gazebo Harmonic + ROS bridge (Jazzy default) -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
