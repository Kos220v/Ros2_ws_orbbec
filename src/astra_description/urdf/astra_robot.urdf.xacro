<?xml version="1.0"?>
<!--
  astra_robot.urdf.xacro
  Diff-drive mobile base with an Orbbec Astra 3D camera mounted on top.
  TF tree:
    base_footprint -> base_link -> {left_wheel, right_wheel, caster, camera_link}
    camera_link -> camera_depth_frame -> camera_depth_optical_frame
    camera_link -> camera_rgb_frame   -> camera_rgb_optical_frame

  The optical frames follow the REP-103 convention (z forward, x right, y down)
  which is what the astra_camera driver publishes images in, so RTAB-Map
  rgbd_odometry works out of the box.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="astra_robot">

  <!-- When true, Gazebo (Harmonic) sensor + plugin tags are included so the
       same model can be spawned in simulation. Set via:
         xacro astra_robot.urdf.xacro use_gazebo:=true -->
  <xacro:arg name="use_gazebo" default="false"/>


  <!-- ===================== Parameters ===================== -->
  <xacro:property name="base_length"  value="0.30"/>
  <xacro:property name="base_width"   value="0.28"/>
  <xacro:property name="base_height"  value="0.12"/>
  <xacro:property name="base_mass"    value="4.0"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width"  value="0.03"/>
  <xacro:property name="wheel_mass"   value="0.3"/>
  <!-- distance between the two wheel contact points -->
  <xacro:property name="wheel_separation" value="0.30"/>
  <!-- z of the wheel axis relative to base_link origin -->
  <xacro:property name="wheel_zoff"   value="0.0"/>
  <!-- forward offset of the wheel axis from base_link origin -->
  <xacro:property name="wheel_xoff"   value="0.0"/>

  <xacro:property name="caster_radius" value="0.02"/>

  <!-- Camera mounting (Astra) relative to base_link -->
  <xacro:property name="cam_x" value="0.13"/>
  <xacro:property name="cam_y" value="0.0"/>
  <xacro:property name="cam_z" value="0.10"/>

  <!-- Astra depth-to-RGB baseline (approx, from datasheet) -->
  <xacro:property name="cam_rgb_yoff"   value="-0.025"/>
  <xacro:property name="cam_depth_yoff" value="0.0"/>

  <xacro:property name="PI" value="3.14159265359"/>

  <!-- ===================== Macros ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
        izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia
        ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
        iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
        izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="dark_grey"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${wheel_xoff} ${reflect*wheel_separation/2.0} ${wheel_zoff}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ===================== Materials ===================== -->
  <material name="blue">      <color rgba="0.1 0.3 0.8 1.0"/></material>
  <material name="dark_grey"> <color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="light_grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
  <material name="black">     <color rgba="0.05 0.05 0.05 1.0"/></material>

  <!-- ===================== Base ===================== -->
  <!-- base_footprint sits on the ground directly below base_link -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_height/2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
  </link>

  <!-- ===================== Wheels ===================== -->
  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

  <!-- ===================== Caster ===================== -->
  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="${caster_radius}"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><sphere radius="${caster_radius}"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="${-base_length/2.0 + caster_radius} 0 ${-wheel_radius + caster_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Astra camera ===================== -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- Astra body ~ 165 x 30 x 40 mm -->
        <box size="0.04 0.165 0.03"/>
      </geometry>
      <material name="light_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.165 0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} ${cam_y} ${cam_z}" rpy="0 0 0"/>
  </joint>

  <!-- Depth frame + optical frame -->
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0 ${cam_depth_yoff} 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_depth_optical_frame"/>
  <joint name="camera_depth_optical_joint" type="fixed">
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- RGB frame + optical frame -->
  <link name="camera_rgb_frame"/>
  <joint name="camera_rgb_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_rgb_frame"/>
    <origin xyz="0 ${cam_rgb_yoff} 0" rpy="0 0 0"/>
  </joint>

  <link name="camera_rgb_optical_frame"/>
  <joint name="camera_rgb_optical_joint" type="fixed">
    <parent link="camera_rgb_frame"/>
    <child link="camera_rgb_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ===================== Gazebo (simulation only) ===================== -->
  <xacro:if value="$(arg use_gazebo)">
    <xacro:include filename="$(find astra_description)/urdf/astra_robot.gazebo.xacro"/>
    <xacro:astra_gazebo/>
  </xacro:if>

</robot>
