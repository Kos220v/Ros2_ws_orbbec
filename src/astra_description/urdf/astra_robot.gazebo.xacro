<?xml version="1.0"?>
<!--
  astra_robot.gazebo.xacro
  Gazebo Harmonic (gz-sim 8, ROS 2 Jazzy) additions for the astra_robot model.

  Provides:
    * material colours for the sim
    * diff-drive plugin  (subscribes /cmd_vel, publishes WHEEL odometry as a
      ground-truth-ish reference on /wheel/odometry + TF is left to VO)
    * joint-state publisher plugin
    * an RGB-D camera sensor on camera_link that emulates the Astra and feeds
      RTAB-Map exactly like the real astra_camera driver

  The RGB-D sensor publishes (Gazebo topics, later bridged to ROS):
    /camera/image                camera (RGB)
    /camera/depth_image          depth
    /camera/camera_info          camera info
    /camera/points               point cloud
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="astra_gazebo">

    <!-- ===== Visual materials in Gazebo ===== -->
    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
    </gazebo>
    <gazebo reference="left_wheel">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="right_wheel">
      <material>Gazebo/DarkGrey</material>
      <mu1>1.0</mu1><mu2>1.0</mu2>
    </gazebo>
    <gazebo reference="caster_wheel">
      <material>Gazebo/Black</material>
      <!-- low friction so the caster slides freely -->
      <mu1>0.05</mu1><mu2>0.05</mu2>
    </gazebo>
    <gazebo reference="camera_link">
      <material>Gazebo/Grey</material>
    </gazebo>

    <!-- ===== Differential drive ===== -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.30</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <odom_publish_frequency>30</odom_publish_frequency>
        <topic>cmd_vel</topic>
        <!-- Publish wheel odometry on a SEPARATE topic so it does not clash
             with the visual /odom from RTAB-Map. Use it as a reference. -->
        <odom_topic>wheel/odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_footprint</child_frame_id>
        <!-- Do NOT publish TF here: the VO node owns odom->base_footprint -->
        <tf_topic>/diff_drive/tf_unused</tf_topic>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
        <max_angular_acceleration>2.0</max_angular_acceleration>
        <min_angular_acceleration>-2.0</min_angular_acceleration>
      </plugin>
    </gazebo>

    <!-- ===== Joint states ===== -->
    <gazebo>
      <plugin filename="gz-sim-joint-state-publisher-system"
              name="gz::sim::systems::JointStatePublisher">
        <topic>joint_states</topic>
        <joint_name>left_wheel_joint</joint_name>
        <joint_name>right_wheel_joint</joint_name>
      </plugin>
    </gazebo>

    <!-- ===== Ground-truth pose (for evaluation) ===== -->
    <gazebo>
      <plugin filename="gz-sim-odometry-publisher-system"
              name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>base_footprint</robot_base_frame>
        <odom_topic>ground_truth/odometry</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>3</dimensions>
      </plugin>
    </gazebo>

    <!-- ===== Astra RGB-D camera ===== -->
    <gazebo reference="camera_link">
      <sensor name="astra_rgbd" type="rgbd_camera">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <!-- Publish under the 'camera' prefix; images carry the optical frame -->
        <topic>camera</topic>
        <gz_frame_id>camera_rgb_optical_frame</gz_frame_id>
        <camera name="astra">
          <horizontal_fov>1.047</horizontal_fov> <!-- ~60 deg like Astra -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>10.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.3</near>
              <far>8.0</far>   <!-- Astra depth range -->
            </clip>
          </depth_camera>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </gazebo>

    <!-- Make the Sensors system aware of the camera link -->
    <gazebo>
      <plugin filename="gz-sim-sensors-system"
              name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>
