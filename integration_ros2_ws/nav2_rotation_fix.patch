diff --git a/src/robot_navigation/config/nav2_params.yaml b/src/robot_navigation/config/nav2_params.yaml
index 511c9f0..fcaa7df 100644
--- a/src/robot_navigation/config/nav2_params.yaml
+++ b/src/robot_navigation/config/nav2_params.yaml
@@ -44,8 +44,9 @@ bt_navigator:
 
 controller_server:
   ros__parameters:
-    # 20 Гц штатно; если Pi4 не тянет — снижайте до 10 Гц.
-    controller_frequency: 20.0
+    # 10 Гц: на слабом железе/в симуляции контроллер не успевал за 20 Гц
+    # (Control loop missed its desired rate) — снижено вдвое для надёжности.
+    controller_frequency: 10.0
     costmap_update_timeout: 0.30
     min_x_velocity_threshold: 0.001
     min_y_velocity_threshold: 0.5
@@ -68,10 +69,12 @@ controller_server:
 
     progress_checker:
       plugin: "nav2_controller::SimpleProgressChecker"
-      # Робот обязан проехать 0.5 м за 15 с, иначе считаем, что он застрял
-      # (на траве/гравии разгон медленнее, чем в помещении, поэтому 15 с).
-      required_movement_radius: 0.5
-      movement_time_allowance: 15.0
+      # Робот обязан проехать 0.1 м за 30 с. Порог снижен (0.5->0.1 м) и время
+      # увеличено (15->30 с): тяжёлый гусеничный робот на старте долго
+      # разворачивается на месте, почти не смещаясь, — со старым порогом Nav2
+      # ошибочно объявлял "Failed to make progress" ещё до начала движения.
+      required_movement_radius: 0.1
+      movement_time_allowance: 30.0
 
     general_goal_checker:
       stateful: True
@@ -84,8 +87,37 @@ controller_server:
       # иначе робот будет разворачиваться на месте в каждой точке.
       yaw_goal_tolerance: 3.14
 
+    # === RotationShimController ===========================================
+    # Обёртка вокруг RegulatedPurePursuit. Regulated Pure Pursuit сам по себе
+    # ПЛОХО разворачивается на месте: когда цель сильно сбоку/сзади, он шлёт
+    # слабые виляющие angular-команды (±0.1..0.25 рад/с, знак скачет), которых
+    # не хватает, чтобы стронуть тяжёлый гусеничный робот, — робот стоит и
+    # дёргается. RotationShim ПЕРЕД движением делает чистый уверенный разворот
+    # на месте до нужного курса своей командой, затем передаёт управление RPP.
+    # Это штатный фикс Nav2 для дифференциальных/гусеничных роботов.
     FollowPath:
-      plugin: "nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"
+      plugin: "nav2_rotation_shim_controller::RotationShimController"
+      # какой контроллер запускать после доворота
+      primary_controller: "nav2_regulated_pure_pursuit_controller::RegulatedPurePursuitController"
+      # начинать доворот, если путь уходит в сторону больше чем на ~9°.
+      # Порог снижен (было ~16°): при меньших углах управление раньше брал RPP
+      # и «капал» слабым angular ~0.1 рад/с, которого не хватало стронуть
+      # тяжёлый гусеничный робот. Теперь почти любой доворот делает shim.
+      angular_dist_threshold: 0.15       # рад (~9°)
+      forward_sampling_distance: 0.5
+      # передавать управление RPP при совпадении курса до ~14° (было ~4.6°).
+      # Узкий порог в медленной симуляции приводил к overshoot: робот
+      # проскакивал цель на ±15°, снова доворачивался, снова проскакивал — и
+      # НИКОГДА не попадал в узкую зону, поэтому вперёд не ехал. Широкий порог
+      # отдаёт управление RPP раньше, дальше он едет вперёд И подруливает.
+      angular_disengage_threshold: 0.25  # рад (~14°)
+      # ПРИМЕЧАНИЕ: rotate_to_heading_angular_vel и max_angular_accel задаются
+      # ОДИН раз ниже (в блоке RPP) — это общие параметры для shim и RPP.
+      simulate_ahead_time: 1.0
+      rotate_to_goal_heading: false
+      # closed-loop не нужен, курс берём из TF
+      closed_loop: false
+      # ↓↓↓ параметры основного контроллера (RegulatedPurePursuit) ↓↓↓
 
       # --- скорости -------------------------------------------------------
       desired_linear_vel: 0.6          # крейсерская скорость, м/с
@@ -113,10 +145,16 @@ controller_server:
       # --- повороты на месте -----------------------------------------------
       # Гусеничный робот умеет разворачиваться на месте — пользуемся этим,
       # когда путь уходит сильно вбок.
+      # RPP разворачивается на месте, ТОЛЬКО если отклонение > ~46°. Порог
+      # намеренно ВЫШЕ, чем angular_disengage_threshold shim'а (~14°): при
+      # передаче управления от shim RPP должен ЕХАТЬ ВПЕРЁД и подруливать, а не
+      # снова застревать в развороте на месте (из-за чего было качание ±15°).
       use_rotate_to_heading: true
-      rotate_to_heading_min_angle: 0.6      # рад (~34°)
-      rotate_to_heading_angular_vel: 0.8    # рад/с
-      max_angular_accel: 2.0
+      rotate_to_heading_min_angle: 0.8      # рад (~46°)
+      # общая скорость/ускорение разворота на месте для shim и RPP.
+      # 0.5 рад/с (не 0.8): мягче, робот не проскакивает курс в медленной симе.
+      rotate_to_heading_angular_vel: 0.5    # рад/с
+      max_angular_accel: 1.5
 
       # Задний ход запрещён: сзади нет ни лидара, ни камеры — ехать вслепую
       # по улице опасно.
