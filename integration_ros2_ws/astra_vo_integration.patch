-
-def quaternion_from_yaw(yaw):
-    """Создаёт кватернион из угла рысканья (roll=pitch=0)."""
-    cy = math.cos(yaw * 0.5)
-    sy = math.sin(yaw * 0.5)
-    return Quaternion(x=0.0, y=0.0, z=sy, w=cy)
-
-
-def wrap_angle(a):
-    """Приводит угол к диапазону [-pi, pi]."""
-    return math.atan2(math.sin(a), math.cos(a))
