-def scan(bus):
-    """Возвращает список отвечающих адресов. Аналог i2cdetect -y 1."""
-    found = []
-    for addr in range(0x03, 0x78):
-        try:
-            bus.read_byte(addr)
-            found.append(addr)
-        except Exception:
-            pass
-    return found
