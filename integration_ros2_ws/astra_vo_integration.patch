@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+"""
+rgbd_odometry.launch.py — ВИЗУАЛЬНАЯ одометрия RTAB-Map по RGB-D с Astra.
+
+Заменяет колёсную одометрию (robot_odom) + курс от IMU/компаса. Публикует
+nav_msgs/Odometry в тот же топик /odom, который слушают оба EKF, поэтому
+конфиги EKF не надо переучивать на другое имя.
+
+TF odom -> base_link здесь НЕ публикуется (publish_tf:=false): этот трансформ
+по-прежнему принадлежит ekf_filter_node_odom. Если включить publish_tf,
+за один и тот же трансформ будут драться двое, и робот «запрыгает» в RViz.
+
+Подписки (ремап на топики astra_camera):
+    rgb/image       <- /camera/color/image_raw
+    depth/image     <- /camera/depth/image_raw   (registered to color)
+    rgb/camera_info <- /camera/color/camera_info
+
+Публикация:
+    /odom           nav_msgs/Odometry (поза X/Y + курс yaw + линейная/угловая
+                    скорости) — визуальная одометрия
+"""
+
+from launch import LaunchDescription
+from launch.actions import DeclareLaunchArgument
+from launch.substitutions import LaunchConfiguration
+from launch_ros.actions import Node
+from launch_ros.parameter_descriptions import ParameterValue
+
+
+def generate_launch_description():
+    use_sim_time = LaunchConfiguration('use_sim_time')
+    publish_tf = LaunchConfiguration('publish_tf')
+    frame_id = LaunchConfiguration('frame_id')
+    odom_frame_id = LaunchConfiguration('odom_frame_id')
+    approx_sync = LaunchConfiguration('approx_sync')
+    approx_sync_max_interval = LaunchConfiguration('approx_sync_max_interval')
+    qos = LaunchConfiguration('qos')
+    rgb_topic = LaunchConfiguration('rgb_topic')
+    depth_topic = LaunchConfiguration('depth_topic')
+    camera_info_topic = LaunchConfiguration('camera_info_topic')
+    odom_topic = LaunchConfiguration('odom_topic')
+    # RTAB-Map ждёт эти параметры СТРОКАМИ. LaunchConfiguration с числовым
+    # значением ('1000') launch отдал бы как int -> InvalidParameterType.
+    # ParameterValue(..., value_type=str) форсирует строковый тип.
+    vis_max_features = ParameterValue(
+        LaunchConfiguration('vis_max_features'), value_type=str)
+    vis_min_inliers = ParameterValue(
+        LaunchConfiguration('vis_min_inliers'), value_type=str)
+
+    return LaunchDescription([
+        # publish_tf:=false — TF odom->base_link принадлежит EKF (см. docstring)
+        DeclareLaunchArgument('use_sim_time', default_value='false'),
+        DeclareLaunchArgument('publish_tf', default_value='false'),
+        DeclareLaunchArgument('frame_id', default_value='base_link'),
+        DeclareLaunchArgument('odom_frame_id', default_value='odom'),
+        DeclareLaunchArgument('approx_sync', default_value='true'),
+        # Макс. рассинхрон rgb/depth, при котором пара кадров ещё принимается.
+        # У оригинальной Astra потоки не синхронны (~0.03-0.05 с), и синхро-
+        # низатор по умолчанию браковал такие пары -> при движении одометрия
+        # дёргалась/дрейфовала. 0.05 с покрывает реальный разброс Astra.
+        DeclareLaunchArgument('approx_sync_max_interval', default_value='0.05'),
+        DeclareLaunchArgument('qos', default_value='2'),
+        # Больше фич + мягче порог инлайеров = устойчивее трекинг на смазанных
+        # кадрах во время поворота (главная причина срыва VO при вращении).
+        DeclareLaunchArgument('vis_max_features', default_value='1000'),
+        DeclareLaunchArgument('vis_min_inliers', default_value='15'),
+        DeclareLaunchArgument('rgb_topic',
+                              default_value='/camera/color/image_raw'),
+        DeclareLaunchArgument('depth_topic',
+                              default_value='/camera/depth/image_raw'),
+        DeclareLaunchArgument('camera_info_topic',
+                              default_value='/camera/color/camera_info'),
+        DeclareLaunchArgument('odom_topic', default_value='/odom'),
+
+        Node(
+            package='rtabmap_odom',
+            executable='rgbd_odometry',
+            name='rgbd_odometry',
+            output='screen',
+            parameters=[{
+                'use_sim_time': use_sim_time,
+                'frame_id': frame_id,
+                'odom_frame_id': odom_frame_id,
+                'publish_tf': publish_tf,
+                'approx_sync': approx_sync,
+                'approx_sync_max_interval': approx_sync_max_interval,
+                'qos': qos,
+                'qos_camera_info': qos,
+                'wait_for_transform': 0.2,
+                'subscribe_rgbd': False,
+                'Odom/Strategy': '0',        # 0=Frame-to-Map
+                'Vis/FeatureType': '6',      # 6=GFTT/BRIEF
+                'OdomF2M/MaxSize': '1000',
+                # Кол-во фич на кадр. Больше -> устойчивее при повороте, где
+                # часть фич уходит из поля зрения / смазывается.
+                'Vis/MaxFeatures': vis_max_features,
+                # Мин. число инлайеров для валидной оценки движения. Ниже порог
+                # (было 20 по умолчанию) -> VO реже "срывается" на бедных/
+                # смазанных кадрах, но слишком низкий даёт шум. 15 — компромисс.
+                'Vis/MinInliers': vis_min_inliers,
+                # Держать больше локальных фич для сопоставления между кадрами —
+                # помогает восстановить трек после быстрого поворота.
+                'OdomF2M/MaxNewFeatures': '0',
+                'Odom/ResetCountdown': '1',  # авто-сброс после потери трекинга
+                'Odom/GuessMotion': 'true',
+            }],
+            remappings=[
+                ('rgb/image', rgb_topic),
+                ('depth/image', depth_topic),
+                ('rgb/camera_info', camera_info_topic),
+                ('odom', odom_topic),
+            ],
+        ),
+    ])
