-    sectors = set()
-    for x, y in zip(xs, ys):
-        angle = math.atan2(y - cy, x - cx)
-        sectors.add(
-            int((angle + math.pi) / (2 * math.pi) * N_SECTORS) % N_SECTORS)
-    return sectors
