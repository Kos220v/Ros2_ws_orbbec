@@ -0,0 +1,38 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
+<package format="3">
+  <name>astra_odometry</name>
+  <version>0.1.0</version>
+  <description>
+    Визуальная одометрия RTAB-Map (rgbd_odometry) с камеры Orbbec Astra
+    (драйвер astra_camera / OpenNI). Публикует /odom (поза + курс + скорости)
