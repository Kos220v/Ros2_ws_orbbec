-# imu_filter_madgwick — слияние MPU6050 (гироскоп + акселерометр) и
-# магнитометра QMC5883L/HMC5883L в АБСОЛЮТНУЮ ориентацию.
-#
-# Вход:  /imu/data_raw (sensor_msgs/Imu без ориентации, от mpu6050_control)
-#        /imu/mag      (sensor_msgs/MagneticField, от mag_declination_node)
-# Выход: /imu/data     (sensor_msgs/Imu с полем orientation)
-#
-# Именно этот узел заменяет самописное слияние компаса и гироскопа: гироскоп
-# даёт быструю динамику поворота, магнитометр убирает дрейф, а фильтр Маджвика
-# корректно объединяет их без «залипания» и без скачков через ±180°.
-# ============================================================================
-imu_filter_madgwick:
-  ros__parameters:
-    # ENU (East-North-Up) — соглашение REP-103, которого требует
-    # robot_localization и Nav2. 0° = восток, +90° = север.
