-def read_word_2c(bus, addr, reg):
-    """Читает 16-битное знаковое значение (старший байт первым)."""
-    high = bus.read_byte_data(addr, reg)
-    low = bus.read_byte_data(addr, reg + 1)
-    val = (high << 8) + low
-    return val - 65536 if val >= 0x8000 else val
-
