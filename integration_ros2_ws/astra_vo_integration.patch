-    # Использовать магнитометр. Без него курс будет уплывать по гироскопу
-    # и уличная навигация работать не будет.
-    use_mag: true
-
-    # Подписываться на sensor_msgs/MagneticField (а не устаревший Vector3Stamped).
-    use_magnetic_field_msg: true
-
-    # TF не публикуем: ориентацию робота публикуют EKF-узлы, а два источника
-    # одного трансформа сломают TF-дерево.
-    publish_tf: false
-
-    # Коэффициент фильтра: больше — быстрее сходится, но шумнее.
-    # 0.1 — значение по умолчанию, хорошо работает на подвижном шасси.
