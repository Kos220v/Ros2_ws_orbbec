diff --git a/src/astra_gazebo/scripts/ground_truth_to_odom.py b/src/astra_gazebo/scripts/ground_truth_to_odom.py
new file mode 100755
index 0000000..ace5d78
--- /dev/null
+++ b/src/astra_gazebo/scripts/ground_truth_to_odom.py
@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+# -*- coding: utf-8 -*-
+
+"""
+ground_truth_to_odom.py — ретранслятор эталонной одометрии в /odom.
+
+Берёт точную позу робота из симулятора (/ground_truth/odometry, публикует
+плагин gz OdometryPublisher) и переопубликовывает её в /odom с корректными
+именами фреймов (frame_id=odom, child_frame_id=base_link), которые ждёт EKF.
+
+Нужен для режима odom_source:=ground_truth: позволяет проверить всю связку
+EKF -> GPS -> navsat -> Nav2 на ИДЕАЛЬНОЙ одометрии, не завися от капризов
+визуальной одометрии на синтетической картинке. TF odom->base_link НЕ
+публикуется — он принадлежит ekf_filter_node_odom (как и с настоящей VO).
+
+Ковариацию ставим маленькой, но НЕнулевой, иначе EKF ругается на вырожденную
+матрицу.
+"""
+
+import rclpy
+from rclpy.node import Node
+from nav_msgs.msg import Odometry
+
+
+class GroundTruthToOdom(Node):
+    def __init__(self):
+        super().__init__('ground_truth_to_odom')
+        self.declare_parameter('input_topic', '/ground_truth/odometry')
+        self.declare_parameter('output_topic', '/odom')
+        self.declare_parameter('odom_frame', 'odom')
+        self.declare_parameter('base_frame', 'base_link')
+
+        in_topic = self.get_parameter('input_topic').value
+        out_topic = self.get_parameter('output_topic').value
+        self.odom_frame = self.get_parameter('odom_frame').value
+        self.base_frame = self.get_parameter('base_frame').value
+
+        self.pub = self.create_publisher(Odometry, out_topic, 10)
+        self.sub = self.create_subscription(
+            Odometry, in_topic, self.cb, 10)
+        self.get_logger().info(
+            'ground_truth_to_odom: %s -> %s (frame=%s child=%s)'
+            % (in_topic, out_topic, self.odom_frame, self.base_frame))
+
+    def cb(self, msg):
+        out = Odometry()
+        out.header.stamp = msg.header.stamp
+        out.header.frame_id = self.odom_frame
+        out.child_frame_id = self.base_frame
+        out.pose = msg.pose
+        out.twist = msg.twist
+
+        # Небольшая ненулевая ковариация (эталон почти точный)
+        pose_cov = [0.0] * 36
+        twist_cov = [0.0] * 36
+        for i, idx in enumerate((0, 7, 14, 21, 28, 35)):
+            pose_cov[idx] = 1e-4
+            twist_cov[idx] = 1e-4
+        out.pose.covariance = pose_cov
+        out.twist.covariance = twist_cov
+
+        self.pub.publish(out)
+
+
+def main(args=None):
+    rclpy.init(args=args)
+    node = GroundTruthToOdom()
+    try:
+        rclpy.spin(node)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        node.destroy_node()
+        if rclpy.ok():
+            rclpy.shutdown()
+
+
+if __name__ == '__main__':
+    main()
diff --git a/src/astra_gazebo/urdf/tracked_robot_sim.gazebo.xacro b/src/astra_gazebo/urdf/tracked_robot_sim.gazebo.xacro
new file mode 100644
index 0000000..7601d6c
--- /dev/null
+++ b/src/astra_gazebo/urdf/tracked_robot_sim.gazebo.xacro
@@ -0,0 +1,167 @@
+<?xml version="1.0"?>
+<!--
+  tracked_robot_sim.gazebo.xacro
+  Плагины и сенсоры Gazebo Harmonic (gz-sim 8, ROS 2 Jazzy) для симуляции.
+
+  Публикует (gz-топики, далее мостятся в ROS через bridge.yaml):
+    cmd_vel            <- команды скорости (в DiffDrive)
+    joint_states       -> состояния колёс
+    wheel/odometry     -> одометрия по колёсам (референс, НЕ основной /odom)
+    ground_truth/odometry -> точная поза из симулятора (эталон для оценки)
+    camera/image, camera/depth_image, camera/camera_info, camera/points -> Astra
+    scan               -> 2D-лидар (как YDLidar)
+    gps/fix (navsat)   -> GNSS-приёмник
+
+  ВАЖНО: основной /odom даёт ВИЗУАЛЬНАЯ одометрия (rgbd_odometry на картинках
+  этой камеры), а НЕ wheel/odometry. Так проверяется тот же VO-пайплайн, что и
+  на реальном роботе.
+-->
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
+
+  <xacro:macro name="sim_gazebo">
+
+    <!-- ===== Материалы и трение =====
+         Skid-steer поворачивает за счёт БОКОВОГО проскальзывания гусениц.
+         Поэтому продольное трение (mu1, вдоль fdir1 = вперёд) высокое —
+         хорошее сцепление на ход; боковое (mu2) низкое — колёса легко скользят
+         вбок, позволяя корпусу разворачиваться на месте. Если mu1==mu2 и оба
+         высокие, колёса «прилипают» и робот едет прямо, но не поворачивает. -->
+    <gazebo reference="base_link"><material>Gazebo/Turquoise</material></gazebo>
+    <gazebo reference="left_track"><material>Gazebo/DarkGrey</material></gazebo>
+    <gazebo reference="right_track"><material>Gazebo/DarkGrey</material></gazebo>
+    <gazebo reference="front_left_wheel">
+      <material>Gazebo/Black</material>
+      <mu1>1.0</mu1><mu2>0.2</mu2>
+      <fdir1>1 0 0</fdir1>
+    </gazebo>
+    <gazebo reference="rear_left_wheel">
+      <material>Gazebo/Black</material>
+      <mu1>1.0</mu1><mu2>0.2</mu2>
+      <fdir1>1 0 0</fdir1>
+    </gazebo>
+    <gazebo reference="front_right_wheel">
+      <material>Gazebo/Black</material>
+      <mu1>1.0</mu1><mu2>0.2</mu2>
+      <fdir1>1 0 0</fdir1>
+    </gazebo>
+    <gazebo reference="rear_right_wheel">
+      <material>Gazebo/Black</material>
+      <mu1>1.0</mu1><mu2>0.2</mu2>
+      <fdir1>1 0 0</fdir1>
+    </gazebo>
+
+    <!-- ===== Skid-steer diff-drive (2 колеса на борт) ===== -->
+    <gazebo>
+      <plugin filename="gz-sim-diff-drive-system"
+              name="gz::sim::systems::DiffDrive">
+        <num_wheel_pairs>2</num_wheel_pairs>
+        <left_joint>front_left_wheel_joint</left_joint>
+        <left_joint>rear_left_wheel_joint</left_joint>
+        <right_joint>front_right_wheel_joint</right_joint>
+        <right_joint>rear_right_wheel_joint</right_joint>
+        <wheel_separation>0.48</wheel_separation>
+        <wheel_radius>0.11</wheel_radius>
+        <odom_publish_frequency>30</odom_publish_frequency>
+        <topic>cmd_vel</topic>
+        <odom_topic>wheel/odometry</odom_topic>
+        <frame_id>odom</frame_id>
+        <child_frame_id>base_link</child_frame_id>
+        <!-- TF odom->base_link принадлежит EKF, не этому плагину -->
+        <tf_topic>/diff_drive/tf_unused</tf_topic>
+        <max_linear_acceleration>1.0</max_linear_acceleration>
+        <min_linear_acceleration>-1.0</min_linear_acceleration>
+        <max_angular_acceleration>2.0</max_angular_acceleration>
+        <min_angular_acceleration>-2.0</min_angular_acceleration>
+      </plugin>
+    </gazebo>
+
+    <!-- ===== Состояния суставов ===== -->
+    <gazebo>
+      <plugin filename="gz-sim-joint-state-publisher-system"
+              name="gz::sim::systems::JointStatePublisher">
+        <topic>joint_states</topic>
+        <joint_name>front_left_wheel_joint</joint_name>
+        <joint_name>rear_left_wheel_joint</joint_name>
+        <joint_name>front_right_wheel_joint</joint_name>
+        <joint_name>rear_right_wheel_joint</joint_name>
+      </plugin>
+    </gazebo>
+
+    <!-- ===== Эталонная поза (ground truth) ===== -->
+    <gazebo>
+      <plugin filename="gz-sim-odometry-publisher-system"
+              name="gz::sim::systems::OdometryPublisher">
+        <odom_frame>world</odom_frame>
+        <robot_base_frame>base_link</robot_base_frame>
+        <odom_topic>ground_truth/odometry</odom_topic>
+        <odom_publish_frequency>30</odom_publish_frequency>
+        <dimensions>3</dimensions>
+      </plugin>
+    </gazebo>
+
+    <!-- ===== Astra RGB-D камера ===== -->
+    <gazebo reference="camera_link">
+      <sensor name="astra_rgbd" type="rgbd_camera">
+        <always_on>1</always_on>
+        <update_rate>30</update_rate>
+        <visualize>true</visualize>
+        <topic>camera</topic>
+        <gz_frame_id>camera_rgb_optical_frame</gz_frame_id>
+        <camera name="astra">
+          <horizontal_fov>1.047</horizontal_fov>
+          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
+          <clip><near>0.1</near><far>10.0</far></clip>
+          <depth_camera><clip><near>0.3</near><far>8.0</far></clip></depth_camera>
+          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.007</stddev></noise>
+        </camera>
+      </sensor>
+    </gazebo>
+
+    <!-- ===== 2D-лидар (аналог YDLidar) ===== -->
+    <gazebo reference="laser_frame">
+      <sensor name="lidar_2d" type="gpu_lidar">
+        <always_on>1</always_on>
+        <update_rate>10</update_rate>
+        <visualize>true</visualize>
+        <topic>scan</topic>
+        <gz_frame_id>laser_frame</gz_frame_id>
+        <lidar>
+          <scan>
+            <horizontal>
+              <samples>720</samples>
+              <resolution>1</resolution>
+              <min_angle>-3.14159</min_angle>
+              <max_angle>3.14159</max_angle>
+            </horizontal>
+          </scan>
+          <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
+          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
+        </lidar>
+      </sensor>
+    </gazebo>
+
+    <!-- ===== GNSS-приёмник (NavSat) ===== -->
+    <gazebo reference="gps_link">
+      <sensor name="navsat_sensor" type="navsat">
+        <always_on>1</always_on>
+        <update_rate>5</update_rate>
+        <topic>navsat</topic>
+        <gz_frame_id>gps_link</gz_frame_id>
+      </sensor>
+    </gazebo>
+
+    <!-- ===== Системы рендера сенсоров и NavSat ===== -->
+    <gazebo>
+      <plugin filename="gz-sim-sensors-system"
+              name="gz::sim::systems::Sensors">
+        <render_engine>ogre2</render_engine>
+      </plugin>
+    </gazebo>
+    <gazebo>
+      <plugin filename="gz-sim-navsat-system"
+              name="gz::sim::systems::NavSat"/>
+    </gazebo>
+
+  </xacro:macro>
+
+</robot>
diff --git a/src/astra_gazebo/urdf/tracked_robot_sim.urdf.xacro b/src/astra_gazebo/urdf/tracked_robot_sim.urdf.xacro
new file mode 100644
index 0000000..446536e
--- /dev/null
+++ b/src/astra_gazebo/urdf/tracked_robot_sim.urdf.xacro
@@ -0,0 +1,213 @@
+<?xml version="1.0"?>
+<!--
+  tracked_robot_sim.urdf.xacro
+  ФИЗИЧЕСКАЯ модель гусеничного робота для симуляции в Gazebo Harmonic.
+
+  Реальный tracked_robot.urdf.xacro (пакет tracked_robot_description) содержит
+  ТОЛЬКО фреймы датчиков без тел и колёс — этого достаточно для TF на реальном
+  роботе, но в симуляторе робот должен иметь массу, колёса и датчики. Поэтому
+  здесь собрана самостоятельная модель, которая:
+
+    * НАМЕРЕННО повторяет те же имена фреймов, что и реальный URDF
+      (base_link, laser_frame, gps_link, imu_link, camera_link,
+       camera_rgb_optical_frame, camera_depth_optical_frame), чтобы конфиги
+       EKF / Nav2 / navsat_transform работали без единой правки;
+    * моделирует гусеницы как skid-steer: визуальные гусеничные кожухи + 4
+      скрытых ведущих колеса (по 2 на борт), которыми управляет плагин
+      DiffDrive (повороты за счёт разницы скоростей бортов);
+    * несёт RGB-D камеру Astra, 2D-лидар и GPS (NavSat) как gz-сенсоры.
+
+  Габариты — приблизительная оценка АРКОС-1; ПРАВЬТЕ под реальные размеры.
+-->
+<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tracked_robot">
+
+  <xacro:property name="PI" value="3.14159265359"/>
+
+  <!-- ===== Габариты корпуса ===== -->
+  <xacro:property name="base_length" value="0.90"/>
+  <xacro:property name="base_width"  value="0.55"/>
+  <xacro:property name="base_height" value="0.22"/>
+  <xacro:property name="base_mass"   value="100.0"/>
+  <xacro:property name="body_clearance" value="0.14"/>
+
+  <!-- ===== Гусеницы (визуальные кожухи) ===== -->
+  <xacro:property name="track_length" value="0.86"/>
+  <xacro:property name="track_width"  value="0.14"/>
+  <xacro:property name="track_height" value="0.20"/>
+
+  <!-- ===== Ведущие колёса (скрытые, skid-steer) ===== -->
+  <xacro:property name="wheel_radius" value="0.11"/>
+  <xacro:property name="wheel_width"  value="0.12"/>
+  <xacro:property name="wheel_mass"   value="5.0"/>
+  <xacro:property name="wheel_separation" value="0.48"/> <!-- как в kolesa_control -->
+  <xacro:property name="wheel_base"   value="0.50"/>
+
+  <!-- ===== Координаты датчиков (СОВПАДАЮТ с реальным URDF) ===== -->
+  <xacro:property name="imu_xyz"   value="0.135 -0.275 0.4"/>
+  <xacro:property name="gps_xyz"   value="0.10  -0.100 0.42"/>
+  <xacro:property name="laser_xyz" value="-0.21  0.16  0.55"/>
+  <xacro:property name="cam_xyz"   value="0.30  0.0   0.35"/>
+  <xacro:property name="cam_rgb_yoff" value="-0.025"/>
+
+  <!-- ===================== Инерции ===================== -->
+  <xacro:macro name="box_inertia" params="m x y z">
+    <inertial>
+      <mass value="${m}"/>
+      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
+               iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
+               izz="${m*(x*x+y*y)/12.0}"/>
+    </inertial>
+  </xacro:macro>
+
+  <xacro:macro name="cyl_inertia" params="m r h">
+    <inertial>
+      <mass value="${m}"/>
+      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
+               iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
+               izz="${m*r*r/2.0}"/>
+    </inertial>
+  </xacro:macro>
+
+  <xacro:macro name="drive_wheel" params="name reflect lon">
+    <link name="${name}_wheel">
+      <visual>
+        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
+        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
+        <material name="black"/>
+      </visual>
+      <collision>
+        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
+        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
+      </collision>
+      <xacro:cyl_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
+    </link>
+    <joint name="${name}_wheel_joint" type="continuous">
+      <parent link="base_link"/>
+      <child link="${name}_wheel"/>
+      <origin xyz="${lon} ${reflect*wheel_separation/2.0} 0" rpy="0 0 0"/>
+      <axis xyz="0 1 0"/>
+      <dynamics damping="0.1" friction="0.2"/>
+    </joint>
+  </xacro:macro>
+
+  <xacro:macro name="track_visual" params="name reflect">
+    <link name="${name}_track">
+      <visual>
+        <geometry><box size="${track_length} ${track_width} ${track_height}"/></geometry>
+        <material name="dark_grey"/>
+      </visual>
+      <inertial>
+        <mass value="1.0"/>
+        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
+      </inertial>
+    </link>
+    <joint name="${name}_track_joint" type="fixed">
+      <parent link="base_link"/>
+      <child link="${name}_track"/>
+      <origin xyz="0 ${reflect*wheel_separation/2.0} 0" rpy="0 0 0"/>
+    </joint>
+  </xacro:macro>
+
+  <!-- ===================== Материалы ===================== -->
+  <material name="teal">      <color rgba="0.55 0.80 0.78 1.0"/></material>
+  <material name="dark_grey"> <color rgba="0.18 0.18 0.18 1.0"/></material>
+  <material name="light_grey"><color rgba="0.7 0.7 0.7 1.0"/></material>
+  <material name="black">     <color rgba="0.05 0.05 0.05 1.0"/></material>
+
+  <!-- ===================== base_link (корень TF, как в реальном URDF) ===== -->
+  <link name="base_link">
+    <visual>
+      <origin xyz="0 0 ${body_clearance - wheel_radius + base_height/2.0}" rpy="0 0 0"/>
+      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
+      <material name="teal"/>
+    </visual>
+    <collision>
+      <origin xyz="0 0 ${body_clearance - wheel_radius + base_height/2.0}" rpy="0 0 0"/>
+      <geometry><box size="${base_length} ${base_width} ${base_height}"/></geometry>
+    </collision>
+    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"/>
+  </link>
+
+  <!-- ===================== Гусеницы и колёса ===================== -->
+  <xacro:track_visual name="left"  reflect="1"/>
+  <xacro:track_visual name="right" reflect="-1"/>
+  <xacro:drive_wheel name="front_left"  reflect="1"  lon="${ wheel_base/2.0}"/>
+  <xacro:drive_wheel name="rear_left"   reflect="1"  lon="${-wheel_base/2.0}"/>
+  <xacro:drive_wheel name="front_right" reflect="-1" lon="${ wheel_base/2.0}"/>
+  <xacro:drive_wheel name="rear_right"  reflect="-1" lon="${-wheel_base/2.0}"/>
+
+  <!-- ===================== IMU-фрейм (нужен для TF-совместимости) ===== -->
+  <link name="imu_link"/>
+  <joint name="base_to_imu" type="fixed">
+    <parent link="base_link"/><child link="imu_link"/>
+    <origin xyz="${imu_xyz}" rpy="0 0 0"/>
+  </joint>
+
+  <!-- ===================== GPS-антенна ===================== -->
+  <link name="gps_link"/>
+  <joint name="base_to_gps" type="fixed">
+    <parent link="base_link"/><child link="gps_link"/>
+    <origin xyz="${gps_xyz}" rpy="0 0 0"/>
+  </joint>
+
+  <!-- ===================== Лидар ===================== -->
+  <link name="laser_frame">
+    <visual>
+      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
+      <material name="black"/>
+    </visual>
+    <collision><geometry><cylinder radius="0.04" length="0.05"/></geometry></collision>
+    <inertial>
+      <mass value="0.2"/>
+      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
+    </inertial>
+  </link>
+  <joint name="base_to_laser" type="fixed">
+    <parent link="base_link"/><child link="laser_frame"/>
+    <origin xyz="${laser_xyz}" rpy="0 0 0"/>
+  </joint>
+
+  <!-- ===================== Камера Astra ===================== -->
+  <link name="camera_link">
+    <visual>
+      <geometry><box size="0.04 0.165 0.03"/></geometry>
+      <material name="light_grey"/>
+    </visual>
+    <collision><geometry><box size="0.04 0.165 0.03"/></geometry></collision>
+    <inertial>
+      <mass value="0.3"/>
+      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
+    </inertial>
+  </link>
+  <joint name="base_to_camera" type="fixed">
+    <parent link="base_link"/><child link="camera_link"/>
+    <origin xyz="${cam_xyz}" rpy="0 0 0"/>
+  </joint>
+
+  <link name="camera_depth_frame"/>
+  <joint name="camera_depth_joint" type="fixed">
+    <parent link="camera_link"/><child link="camera_depth_frame"/>
+    <origin xyz="0 0 0" rpy="0 0 0"/>
+  </joint>
+  <link name="camera_depth_optical_frame"/>
+  <joint name="camera_depth_optical_joint" type="fixed">
+    <parent link="camera_depth_frame"/><child link="camera_depth_optical_frame"/>
+    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
+  </joint>
+
+  <link name="camera_rgb_frame"/>
+  <joint name="camera_rgb_joint" type="fixed">
+    <parent link="camera_link"/><child link="camera_rgb_frame"/>
+    <origin xyz="0 ${cam_rgb_yoff} 0" rpy="0 0 0"/>
+  </joint>
+  <link name="camera_rgb_optical_frame"/>
+  <joint name="camera_rgb_optical_joint" type="fixed">
+    <parent link="camera_rgb_frame"/><child link="camera_rgb_optical_frame"/>
+    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
+  </joint>
+
+  <!-- ===================== Плагины Gazebo ===================== -->
+  <xacro:include filename="$(find astra_gazebo)/urdf/tracked_robot_sim.gazebo.xacro"/>
+  <xacro:sim_gazebo/>
+
+</robot>
diff --git a/src/astra_gazebo/worlds/outdoor.sdf b/src/astra_gazebo/worlds/outdoor.sdf
new file mode 100644
index 0000000..0745666
--- /dev/null
+++ b/src/astra_gazebo/worlds/outdoor.sdf
@@ -0,0 +1,123 @@
+<?xml version="1.0" ?>
+<!--
+  outdoor.sdf — уличный мир для Gazebo Harmonic.
+
+  Содержит:
+    * заданные spherical_coordinates (широта/долгота) — ОБЯЗАТЕЛЬНО для NavSat,
+      иначе GPS-сенсор не публикует координаты. Значения — Нижний Новгород;
+      поменяйте на свои, если нужно тестировать конкретную местность.
+    * текстурированные препятствия (боксы, цилиндры, стены) — визуальной
+      одометрии нужна текстура в кадре, иначе VO «теряется».
+-->
+<sdf version="1.10">
+  <world name="outdoor">
+
+    <physics name="1ms" type="ignored">
+      <max_step_size>0.002</max_step_size>
+      <real_time_factor>1.0</real_time_factor>
+    </physics>
+
+    <plugin filename="gz-sim-physics-system"
+            name="gz::sim::systems::Physics"/>
+    <plugin filename="gz-sim-user-commands-system"
+            name="gz::sim::systems::UserCommands"/>
+    <plugin filename="gz-sim-scene-broadcaster-system"
+            name="gz::sim::systems::SceneBroadcaster"/>
+    <plugin filename="gz-sim-contact-system"
+            name="gz::sim::systems::Contact"/>
+    <plugin filename="gz-sim-imu-system"
+            name="gz::sim::systems::Imu"/>
+
+    <!-- Точка привязки мира к WGS84 — нужна NavSat-сенсору -->
+    <spherical_coordinates>
+      <surface_model>EARTH_WGS84</surface_model>
+      <world_frame_orientation>ENU</world_frame_orientation>
+      <latitude_deg>56.299145</latitude_deg>
+      <longitude_deg>43.923061</longitude_deg>
+      <elevation>80.0</elevation>
+      <heading_deg>0</heading_deg>
+    </spherical_coordinates>
+
+    <light type="directional" name="sun">
+      <cast_shadows>true</cast_shadows>
+      <pose>0 0 10 0 0 0</pose>
+      <diffuse>0.9 0.9 0.9 1</diffuse>
+      <specular>0.3 0.3 0.3 1</specular>
+      <direction>-0.5 0.3 -1</direction>
+    </light>
+
+    <scene>
+      <ambient>0.5 0.5 0.5 1</ambient>
+      <background>0.7 0.8 0.9 1</background>
+      <grid>false</grid>
+    </scene>
+
+    <model name="ground_plane">
+      <static>true</static>
+      <link name="link">
+        <collision name="collision">
+          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
+        </collision>
+        <visual name="visual">
+          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
+          <material>
+            <ambient>0.35 0.4 0.32 1</ambient>
+            <diffuse>0.5 0.55 0.45 1</diffuse>
+            <specular>0.1 0.1 0.1 1</specular>
+          </material>
+        </visual>
+      </link>
+    </model>
+
+    <!-- ===== Текстурные ориентиры для визуальной одометрии ===== -->
+    <model name="box_red">
+      <static>true</static><pose>4.0 2.0 0.5 0 0 0</pose>
+      <link name="link">
+        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
+        <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
+          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.15 0.15 1</diffuse></material></visual>
+      </link>
+    </model>
+    <model name="box_green">
+      <static>true</static><pose>5.0 -2.5 0.6 0 0 0.6</pose>
+      <link name="link">
+        <collision name="c"><geometry><box><size>1.0 1.4 1.2</size></box></geometry></collision>
+        <visual name="v"><geometry><box><size>1.0 1.4 1.2</size></box></geometry>
+          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material></visual>
+      </link>
+    </model>
+    <model name="cyl_yellow">
+      <static>true</static><pose>8.0 1.0 0.75 0 0 0</pose>
+      <link name="link">
+        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry></collision>
+        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry>
+          <material><ambient>0.6 0.6 0.1 1</ambient><diffuse>0.85 0.85 0.15 1</diffuse></material></visual>
+      </link>
+    </model>
+    <model name="box_blue">
+      <static>true</static><pose>2.0 -4.0 0.5 0 0 0.3</pose>
+      <link name="link">
+        <collision name="c"><geometry><box><size>1.2 0.8 1.0</size></box></geometry></collision>
+        <visual name="v"><geometry><box><size>1.2 0.8 1.0</size></box></geometry>
+          <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.15 0.3 0.85 1</diffuse></material></visual>
+      </link>
+    </model>
+    <model name="box_orange">
+      <static>true</static><pose>10.0 -3.0 0.6 0 0 0</pose>
+      <link name="link">
+        <collision name="c"><geometry><box><size>0.8 2.5 1.2</size></box></geometry></collision>
+        <visual name="v"><geometry><box><size>0.8 2.5 1.2</size></box></geometry>
+          <material><ambient>0.7 0.35 0.05 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
+      </link>
+    </model>
+    <model name="wall_far">
+      <static>true</static><pose>15.0 0.0 1.25 0 0 0</pose>
+      <link name="link">
+        <collision name="c"><geometry><box><size>0.3 16.0 2.5</size></box></geometry></collision>
+        <visual name="v"><geometry><box><size>0.3 16.0 2.5</size></box></geometry>
+          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
+      </link>
+    </model>
+
+  </world>
+</sdf>
