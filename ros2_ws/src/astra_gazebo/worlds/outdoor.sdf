<?xml version="1.0" ?>
<!--
  outdoor.sdf — уличный мир для Gazebo Harmonic.

  Содержит:
    * заданные spherical_coordinates (широта/долгота) — ОБЯЗАТЕЛЬНО для NavSat,
      иначе GPS-сенсор не публикует координаты. Значения — Нижний Новгород;
      поменяйте на свои, если нужно тестировать конкретную местность.
    * текстурированные препятствия (боксы, цилиндры, стены) — визуальной
      одометрии нужна текстура в кадре, иначе VO «теряется».
-->
<sdf version="1.10">
  <world name="outdoor">

    <!-- Шаг 4 мс (250 Гц физики) вместо 2 мс: вдвое меньше нагрузка на CPU,
         чтобы на слабом железе симуляция шла ~реального времени и Nav2 успевал.
         Для колёсного/гусеничного робота точности 4 мс более чем достаточно. -->
    <physics name="4ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <!-- Точка привязки мира к WGS84 — нужна NavSat-сенсору -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>56.299145</latitude_deg>
      <longitude_deg>43.923061</longitude_deg>
      <elevation>80.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.3 -1</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.8 0.9 1</background>
      <grid>false</grid>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.35 0.4 0.32 1</ambient>
            <diffuse>0.5 0.55 0.45 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Текстурные ориентиры для визуальной одометрии ===== -->
    <model name="box_red">
      <static>true</static><pose>4.0 2.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.0 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.0 1.0</size></box></geometry>
          <material><ambient>0.6 0.1 0.1 1</ambient><diffuse>0.8 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_green">
      <static>true</static><pose>5.0 -2.5 0.6 0 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 1.4 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.0 1.4 1.2</size></box></geometry>
          <material><ambient>0.1 0.5 0.1 1</ambient><diffuse>0.15 0.7 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cyl_yellow">
      <static>true</static><pose>8.0 1.0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry>
          <material><ambient>0.6 0.6 0.1 1</ambient><diffuse>0.85 0.85 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_blue">
      <static>true</static><pose>2.0 -4.0 0.5 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.2 0.8 1.0</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>1.2 0.8 1.0</size></box></geometry>
          <material><ambient>0.1 0.2 0.6 1</ambient><diffuse>0.15 0.3 0.85 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box_orange">
      <static>true</static><pose>10.0 -3.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 2.5 1.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.8 2.5 1.2</size></box></geometry>
          <material><ambient>0.7 0.35 0.05 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_far">
      <static>true</static><pose>15.0 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 16.0 2.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.3 16.0 2.5</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
