<?xml version="1.0"?>
<robot name="sim_robot">
  <link name="base_link"><inertial><mass value="35"/><origin xyz="0 0 0"/><inertia ixx="2" ixy="0" ixz="0" iyy="2" iyz="0" izz="2"/></inertial></link>
  <link name="imu_link"/><joint name="base_to_imu" type="fixed"><parent link="base_link"/><child link="imu_link"/><origin xyz="0 0 0.25" rpy="0 0 0"/></joint>
  <link name="gps_link"/><joint name="base_to_gps" type="fixed"><parent link="base_link"/><child link="gps_link"/><origin xyz="0 0 0.3" rpy="0 0 0"/></joint>
  <link name="laser_link"/><joint name="base_to_laser" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0 0 0.35" rpy="0 0 0"/></joint>
</robot>
